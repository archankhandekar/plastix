// Copy to Config/Local.xcconfig (git-ignored). scripts/deploy-iphone.sh writes it for you.
// Your Apple Developer Team ID (10 characters), from developer.apple.com/account > Membership details.
DEVELOPMENT_TEAM =
// Bundle identifier registered to that team. Change the prefix to your organization's reverse domain.
PRODUCT_BUNDLE_IDENTIFIER = org.research.symmetry.SymmetryPrototype
